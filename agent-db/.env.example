# Copie este arquivo para .env e preencha com os dados reais.
# .env NUNCA é versionado (vide .gitignore).

# --- Conexão padrão (MySQL Twygo) ---
DB_HOST=seu-host.exemplo.com
DB_PORT=3306
DB_USER=usuario_readonly
DB_PASSWORD=
DB_DATABASE=twygo

# --- Modo de operação ---
# READ_ONLY=1  → bloqueia INSERT/UPDATE/DELETE/DROP no validator (default)
# READ_ONLY=0  → libera writes (opt-in para fixtures de teste)
READ_ONLY=1

# --- Conexões adicionais (opcional) ---
# Use o sufixo _<NOME> para conexões nomeadas referenciadas em config/database.config.yaml
# DB_HOST_STAGING=
# DB_USER_STAGING=
# DB_PASSWORD_STAGING=
# DB_DATABASE_STAGING=
