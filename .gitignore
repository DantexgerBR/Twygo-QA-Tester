.idea/
*.swp
*.swo

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Claude Code (workspace local) =====
.claude/settings.local.json

# Plugin caveman (per-user) — cache de skills baixadas + lock manifest.
# Não-padronizado pelo time; cada dev decide se usa. Análogo a deps de
# editor pessoal. Caveman é instalável via plugin manager; lock pode ser
# regenerado a qualquer momento.
.agents/
skills-lock.json

