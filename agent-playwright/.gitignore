node_modules/
dist/

# Runtime/state files do harness Claude Code — sessionId+pid+lockTime,
# úteis só durante a sessão local; commit pollute o git com churn diário.
.claude/scheduled_tasks.lock

outputs/screenshots/
outputs/traces/
outputs/test-results.json
outputs/test-report.html
outputs/html-report/
outputs/test-artifacts/

# outputs/<slug>/ — gerados por execução (qualquer projeto)
#
# Regra geral: ignorar artefatos crus da run (intermediários), preservar
# o RELATÓRIO PROCESSADO em outputs/<slug>/reports/<slug>_<ts>/ pra QAs
# auxiliares analisarem (report-generator copia artifacts pra dentro do
# reportDir tornando-o self-contained — feedback_archive_artifacts_in_report).
outputs/.auth/
outputs/**/test-artifacts/
outputs/**/exploratory/
outputs/**/exploratory-findings.json
outputs/**/playwright-summary.md
outputs/**/test-results.json
outputs/**/test-analysis.parsed.json
outputs/**/allure-results/
outputs/**/allure-report/
# NÃO ignorar (gerados mas devem ser versionados):
# - outputs/**/reports/      (Markdown self-contained com cópia dos artifacts)
# - outputs/**/triage-report.md  (decisão QA)
# - outputs/**/bug-reports.json  +  outputs/**/bug-reports/  (bug-reports gerados)

# Histórico local de reports antigos: rotacionados automaticamente pelo
# report-generator pós-run. Mantém runs anteriores localmente pra análise/audit
# enquanto git fica só com latest por prefixo (`outputs/<slug>/reports/<prefix>_<ts>/`).
# Cleanup via `rm -rf outputs-archive/` quando histórico não interessar mais.
outputs-archive/

# Arquivos compactados de reports (.rar/.zip/.7z) — usados pra trafegar
# pasta extraída de uma run pra outra máquina via chat/Slack. Frequentemente
# excedem o limite de 100MB do GitHub (caso real: layout-das-abas .rar de
# 168MB rejeitado pelo pre-receive hook). A pasta extraída adjacente já é
# committed.
outputs/**/*.rar
outputs/**/*.zip
outputs/**/*.7z

playwright-report/
test-results/
.playwright/
.playwright-mcp/

.env
.env.local
.env.*.local

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

*.tsbuildinfo
