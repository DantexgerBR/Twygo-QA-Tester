<?xml version="1.0" encoding="UTF-8"?>
<test-analysis>
  <metadata>
    <project>Twygo Frontend - Módulo de Autenticação</project>
    <version>1.0</version>
    <date>2026-04-24</date>
    <author>QA Team</author>
  </metadata>

  <test-scenarios>
    <scenario id="SC001" name="Autenticação de Usuários">
      <description>Validar fluxo de login com credenciais válidas e inválidas</description>

      <test-case id="TC001" name="Login com credenciais válidas">
        <preconditions>
          <condition>Usuário não autenticado</condition>
          <condition>Navegador em estado limpo</condition>
        </preconditions>

        <steps>
          <step id="S001" action="navigate" target="login_page">Navegar para página de login</step>
          <step id="S002" action="fill" locator="email_input" value="user@example.com">Preencher email</step>
          <step id="S003" action="fill" locator="password_input" value="SecurePassword123">Preencher senha</step>
          <step id="S004" action="click" locator="login_button">Clicar em Entrar</step>
          <step id="S005" action="wait_for_navigation">Aguardar redirecionamento</step>
        </steps>

        <expected-results>
          <result id="R001" assertion="url_contains" value="/dashboard">URL deve conter /dashboard</result>
          <result id="R002" assertion="element_visible" target="dashboard_page" locator="user_profile_menu">Menu de perfil visível</result>
          <result id="R003" assertion="text_contains" target="dashboard_page" locator="welcome_message" value="Bem-vindo">Mensagem de boas-vindas</result>
        </expected-results>
      </test-case>

      <test-case id="TC002" name="Login com credenciais inválidas">
        <preconditions>
          <condition>Usuário não autenticado</condition>
        </preconditions>

        <steps>
          <step id="S001" action="navigate" target="login_page">Navegar para página de login</step>
          <step id="S002" action="fill" locator="email_input" value="user@example.com">Preencher email</step>
          <step id="S003" action="fill" locator="password_input" value="WrongPassword">Preencher senha errada</step>
          <step id="S004" action="click" locator="login_button">Clicar em Entrar</step>
        </steps>

        <expected-results>
          <result id="R001" assertion="element_visible" target="login_page" locator="error_alert">Alerta de erro visível</result>
          <result id="R002" assertion="text_contains" target="login_page" locator="error_alert" value="Credenciais inválidas">Mensagem de erro</result>
          <result id="R003" assertion="url_contains" value="/login">Permanece na página de login</result>
        </expected-results>
      </test-case>
    </scenario>
  </test-scenarios>
</test-analysis>
