# Credenciais do agent-playwright — copie para `.env` e preencha.
# `.env` está no .gitignore. NUNCA comitar credenciais.
#
# Como usar:
#   1. cp .env.example .env
#   2. preencha os valores abaixo
#   3. rode `npm run typecheck` pra validar
#
# Os placeholders `${VAR}` em `config/environment.json` resolvem destas variáveis.

# --- staging principal (widgets.stage.twygoead.com — orgId 36988) ---
TWYGO_STAGING_EMAIL=
TWYGO_STAGING_PASSWORD=

# --- staging "widgets desabilitados" (widgetsdisabled.stage.twygoead.com — orgId 36989) ---
# Usado por specs de bloqueio de funcionalidades quando a org está sem o
# módulo Widgets/Painéis ativo. global-setup detecta envs com sufixo
# `-widgets-disabled` (também aceita `-without-credits`) e gera storage
# secundário em outputs/.auth/storage-without-credits.json.
TWYGO_STAGING_WIDGETS_DISABLED_EMAIL=
TWYGO_STAGING_WIDGETS_DISABLED_PASSWORD=
