# Credenciais do agent-playwright — copie para `.env` e preencha.
# `.env` está no .gitignore. NUNCA comitar credenciais.
#
# Como usar:
#   1. cp .env.example .env
#   2. preencha os valores abaixo
#   3. rode `npm run typecheck` pra validar
#
# Os placeholders `${VAR}` em `config/environment.json` resolvem destas variáveis.
#
# DICA: se a senha tiver caractere especial (#, $, espaço), coloque entre aspas
# simples — senão o dotenv corta no `#`/trim. Ex: TWYGO_X_PASSWORD='se#nha$ 123'
#
# Só preencha os envs dos projetos que for rodar — o loader valida apenas o env
# do projeto ativo (os demais podem ficar vazios).

# --- staging principal Twygo (stage10.stage.twygoead.com — orgId 36602) ---
TWYGO_STAGING_EMAIL=
TWYGO_STAGING_PASSWORD=

# --- staging "sem créditos de IA" (eduapi.stage.twygoead.com — orgId 36912) ---
# Usado por specs de bloqueio de funcionalidades quando a org está com saldo
# zerado. global-setup detecta envs com sufixo `-without-credits` e gera
# storage secundário em outputs/.auth/storage-without-credits.json.
TWYGO_STAGING_WITHOUT_CREDITS_EMAIL=
TWYGO_STAGING_WITHOUT_CREDITS_PASSWORD=

# --- staging do projeto Widgets (widgets.stage.twygoead.com — orgId 36988) ---
# Específico do projeto widgets — só preencha se for rodar essa suíte.
TWYGO_STAGING_WIDGETS_EMAIL=
TWYGO_STAGING_WIDGETS_PASSWORD=

# --- staging "widgets desabilitado" (widgetsdisabled.stage.twygoead.com — orgId 36989) ---
# Específico do projeto widgets, simulando módulo desligado.
# global-setup também detecta sufixo `-widgets-disabled`.
TWYGO_STAGING_WIDGETS_DISABLED_EMAIL=
TWYGO_STAGING_WIDGETS_DISABLED_PASSWORD=

# --- trial agentsqa: 5 envs distintos para suite Trial ---
# Cada env representa um motivo/persona de trial (Employee, Course Sale,
# Customer, Partner, Other). orgIds 36977..36981. Hosts trialagentsqa1..5.
# Só preencha os que vai usar — preencher TUDO ou só staging principal é OK.

# trialagentsqa1.stage.twygoead.com — orgId 36977 (motivo Employee)
TWYGO_TRIAL_AGENTSQA_EMPLOYEE_EMAIL=
TWYGO_TRIAL_AGENTSQA_EMPLOYEE_PASSWORD=

# trialagentsqa2.stage.twygoead.com — orgId 36978 (motivo Course Sale)
TWYGO_TRIAL_AGENTSQA_COURSESALE_EMAIL=
TWYGO_TRIAL_AGENTSQA_COURSESALE_PASSWORD=

# trialagentsqa3.stage.twygoead.com — orgId 36979 (motivo Customer)
TWYGO_TRIAL_AGENTSQA_CUSTOMER_EMAIL=
TWYGO_TRIAL_AGENTSQA_CUSTOMER_PASSWORD=

# trialagentsqa4.stage.twygoead.com — orgId 36980 (motivo Partner)
TWYGO_TRIAL_AGENTSQA_PARTNER_EMAIL=
TWYGO_TRIAL_AGENTSQA_PARTNER_PASSWORD=

# trialagentsqa5.stage.twygoead.com — orgId 36981 (motivo Other)
TWYGO_TRIAL_AGENTSQA_OTHER_EMAIL=
TWYGO_TRIAL_AGENTSQA_OTHER_PASSWORD=

# --- staging do projeto Marca d'Água (twygo1772627238.stage.twygoead.com — orgId 36675) ---
# Específico do projeto marca-dagua — conta dante.tavares@twygo.com (admin+aluno).
TWYGO_STAGING_MARCA_DAGUA_EMAIL=
TWYGO_STAGING_MARCA_DAGUA_PASSWORD=

# --- staging do projeto Recertificação — orgs dedicadas do projeto/branch ---
# Principal: recertificacao-testeqa.stage.twygoead.com — orgId 37048
# Feature flag `recertification` habilitada na org. Login: agents.qa@claude.com.
TWYGO_STAGING_RECERTIFICACAO_EMAIL=
TWYGO_STAGING_RECERTIFICACAO_PASSWORD=
# Ambiente adicional pareado (suíte de isolamento entre tenants):
# adicional-certificacao-testeqa.stage.twygoead.com — orgId 37050.
# global-setup loga automaticamente neste env (sufixo `-aditional`).
TWYGO_STAGING_RECERTIFICACAO_ADITIONAL_EMAIL=
TWYGO_STAGING_RECERTIFICACAO_ADITIONAL_PASSWORD=
# Trial do projeto (suíte de exclusão de dados / ciclo trial):
# testerecertificacaotrial.stage.twygoead.com — orgId 37051.
TWYGO_STAGING_RECERTIFICACAO_TRIAL_EMAIL=
TWYGO_STAGING_RECERTIFICACAO_TRIAL_PASSWORD=

# --- staging do projeto Base de Conhecimento (basedeconhecimento.stage.twygoead.com — orgId 37007) ---
# Específico do projeto base-de-conhecimento — só preencha se for rodar essa suíte.
TWYGO_STAGING_BASE_DE_CONHECIMENTO_EMAIL=
TWYGO_STAGING_BASE_DE_CONHECIMENTO_PASSWORD=

# --- staging do projeto Registros (registrosf2.stage.twygoead.com — orgId 37079) ---
