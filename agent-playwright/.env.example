TWYGO_STAGING_REGISTROSF2_EMAIL=
TWYGO_STAGING_REGISTROSF2_PASSWORD=

# --- staging adicional pareado (env "parceira") — necessário p/ suíte ambientes-adicionais-isolamento ---
# Org pareada com o env principal pra testar isolamento de dados entre tenants.
# Valores abaixo são PLACEHOLDER do upstream — ajuste pro seu env adicional real se rodar essa suíte.
TWYGO_STAGING_ADITIONAL_EMAIL=
TWYGO_STAGING_ADITIONAL_PASSWORD=

# --- staging adicional do projeto Widgets (env "parceira" do widgets) ---
# Pareado com staging-widgets p/ suíte de isolamento entre tenants.
TWYGO_STAGING_WIDGETS_ADITIONAL_EMAIL=
TWYGO_STAGING_WIDGETS_ADITIONAL_PASSWORD=

# ============================================================================
# API testing (CONTRACT.md v1.2 — `playwright test --project api`)
# ============================================================================
# Host da API Twygo (separado do host UI; ex: stage10.stage.twygoead.com é UI,
# eduapi.stage.twygoead.com é API). Necessário quando rodar `--project api`.
API_BASE_URL=

# Modo de autenticação dos testes de API. Escolha 1:
#   fixed_token            — usa API_TOKEN abaixo (mais simples; token gerado fora do PW)
#   oauth_password         — POST /oauth/token com API_OAUTH_USERNAME/PASSWORD
#   super_admin_generated  — gerado em runtime via UI Super Admin (futuro)
# Skill canônica: provisionar-token-api-twygo
API_AUTH_MODE=fixed_token

# Bearer token quando API_AUTH_MODE=fixed_token.
# Gerar via Super Admin → orgs → org de teste → "Gerar token API".
API_TOKEN=

# Credenciais quando API_AUTH_MODE=oauth_password (POST /oauth/token).
# Geralmente o mesmo user de UI (admin da org de teste).
API_OAUTH_USERNAME=
API_OAUTH_PASSWORD=
