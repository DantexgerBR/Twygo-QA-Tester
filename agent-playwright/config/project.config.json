{
  "projectName": "twygo-novo-projeto",
  "testAnalysisFile": "inputs/test-analysis.xml",
  "environment": "staging",
  "browsers": ["chromium"],
  "headless": true,
  "reporting": {
    "format": "html",
    "outputDir": "outputs",
    "screenshotsOnFailure": true
  },
  "performance": {
    "enableTracing": true,
    "enableVideo": false
  },
  "codeGeneration": {
    "pagesDir": "src/pages",
    "featuresDir": "tests/features",
    "overwriteExistingPages": false,
    "overwriteExistingTests": true
  },
  "exploratory": {
    "enabled": true,
    "strict": false,
    "probes": {
      "consoleErrors": true,
      "httpErrors": true,
      "brokenImages": true,
      "untestedInteractive": true,
      "a11y": true
    },
    "a11yTags": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "best-practice"],
    "ignoredHttpStatuses": [],
    "ignoredHostnames": []
  }
}
